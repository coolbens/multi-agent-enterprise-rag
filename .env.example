# Backend configuration
# Copy this file to backend/.env for local development.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SECRET_KEY=change-this-secret-key-before-deployment
ENVIRONMENT=development

# SQL database: users, document metadata, chat history
# Leave blank/commented to use backend/storage/app.db
# DATABASE_URL=sqlite:///./storage/app.db

# Embeddings: huggingface works locally after the model downloads once.
EMBEDDING_PROVIDER=huggingface
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector database: chroma by default.
VECTOR_DB_PROVIDER=chroma
CHROMA_COLLECTION=enterprise_docs

# Optional providers
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_docs
